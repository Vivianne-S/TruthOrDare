{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Expo: start dev client",
      "type": "shell",
      "command": "npx expo start --dev-client",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ]
}
